{
  "name": "job-agent-hub",
  "version": "0.1.0",
  "private": true,
  "description": "One pane of glass for an AI-assisted job search: public sanitized activity dashboard + admin panel, backed by ClickUp via a Cloudflare Worker.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p worker/tsconfig.json --noEmit",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
