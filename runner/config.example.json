{
  "hub": "https://jobhunter.prestonzen.com",
  "token": "<RUNNER_TOKEN: same value as the Pages secret>",
  "name": "kloud",
  "slots": 3,
  "timeoutMinutes": 90,
  "workDir": "/var/lib/job-agent-runner/runs",
  "files": ["/home/agent/resume/Preston_Zen_Resume_AI_2026-10-08.pdf"],
  "machineNotes": "This is a Linux runner. Use the playwright MCP tools for the browser (a real Chromium on a virtual display). For each job call get_resume with the job title; the chosen file is in ./resumes/<filename> in your current directory (fallback: ./Preston_Zen_Resume_AI_2026-10-08.pdf). Upload that file and ignore the Windows path in the playbook. You cannot receive email or SMS codes here: report needs_human for those.",
  "agentTokens": {
    "claude": "<hub token>", "codex": "<hub token>", "gemini": "<hub token>",
    "qwen": "<hub token>", "kimi": "<hub token>", "mistral": "<hub token>"
  },
  "agents": {
    "claude":  { "cmd": ["claude", "-p", "{PROMPT}", "--dangerously-skip-permissions"], "auth": ["~/.claude/.credentials.json"] },
    "codex":   { "cmd": ["codex", "exec", "--dangerously-bypass-approvals-and-sandbox", "--skip-git-repo-check", "{PROMPT}"], "auth": ["~/.codex/auth.json"], "env": { "JOBHUNTER_TOKEN": "<codex hub token>" } },
    "gemini":  { "cmd": ["gemini", "--yolo", "-p", "{PROMPT}"], "auth": ["~/.gemini/oauth_creds.json"] },
    "qwen":    { "cmd": ["qwen", "--yolo", "{PROMPT}"], "auth": ["~/.qwen/oauth_creds.json"] },
    "kimi":    { "cmd": ["kimi", "--auto", "-p", "{PROMPT}"], "auth": ["~/.kimi-code/credentials", "~/.kimi-code/auth.json"], "env": { "JOBHUNTER_TOKEN": "<kimi hub token>" } },
    "mistral": { "cmd": ["vibe", "-p", "{PROMPT}", "--auto-approve", "--trust"], "auth": ["~/.vibe/.env"], "versionArgs": ["--version"] }
  }
}
